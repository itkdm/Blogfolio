---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { Menu } from 'lucide-astro';
import { t, localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props { title?: string; description?: string; canonical?: string; image?: string; locale?: Locale; noIndex?: boolean }
const { title = siteConfig.name, description = siteConfig.description, canonical, image = '/og-cover.jpg', locale = Astro.currentLocale === 'zh-CN' ? 'zh-CN' : 'en', noIndex = false } = Astro.props;
const fullTitle = title === siteConfig.name || title.endsWith(`| ${siteConfig.name}`) ? title : `${title} — ${siteConfig.name}`;
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteConfig.url).toString();
const englishPath = localizedPath(Astro.url.pathname, 'en');
const chinesePath = localizedPath(Astro.url.pathname, 'zh-CN');
const imageUrl = new URL(image, siteConfig.url).toString();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, follow" /> : <>
      <link rel="canonical" href={canonicalUrl} />
      <link rel="alternate" hreflang="en" href={new URL(englishPath, siteConfig.url)} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(chinesePath, siteConfig.url)} />
      <link rel="alternate" hreflang="x-default" href={new URL(englishPath, siteConfig.url)} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Blogfolio — A field guide to the personal web" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
          <a class="brand" href={localizedPath('/', locale)} aria-label={`${siteConfig.name} ${t(locale,'nav.home')}`}><span class="brand-mark">b.</span>{siteConfig.name}</a>
        <button class="menu-toggle" aria-label={t(locale,'nav.open')} data-open-label={t(locale,'nav.open')} data-close-label={t(locale,'nav.close')} aria-expanded="false"><Menu size={21} strokeWidth={1.7} /></button>
        <nav class="nav" aria-label={t(locale,'nav.main')}>
          <a href={`${localizedPath('/',locale)}#explore`}>{t(locale,'nav.explore')}</a><a href={localizedPath('/featured',locale)}>{t(locale,'nav.featured')}</a><a href={localizedPath('/about',locale)}>{t(locale,'nav.about')}</a>
          <a class="submit-link" href={localizedPath('/submit',locale)}>{t(locale,'nav.submit')} ↗</a>
          <a class="language-toggle" data-language-toggle href={localizedPath(Astro.url.pathname, locale === 'en' ? 'zh-CN' : 'en')} aria-label={t(locale,locale === 'en' ? 'nav.switchToChinese' : 'nav.switchToEnglish')}>{locale === 'en' ? '中文' : 'EN'}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <a class="brand" href={localizedPath('/',locale)}><span class="brand-mark">b.</span>{siteConfig.name}</a>
            <p class="footer-copy">{t(locale,'footer.blurb')}</p>
          </div>
          <nav class="footer-links" aria-label={t(locale,'footer.nav')}>
            <a href={localizedPath('/about',locale)}>{t(locale,'nav.about')}</a><a href={localizedPath('/submit',locale)}>{t(locale,'nav.submit')}</a>
            <a href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(t(locale,'footer.removeSubject'))}`}>{t(locale,'footer.remove')}</a>
          </nav>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Blogfolio</span><span>{t(locale,'footer.note')}</span></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector('.nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel || '' : toggle.dataset.openLabel || '');
      });
      const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-toggle]');
      languageLink?.addEventListener('click', () => {
        const target = new URL(languageLink.href);
        target.search = window.location.search;
        languageLink.href = target.toString();
      });
    </script>
  </body>
</html>
