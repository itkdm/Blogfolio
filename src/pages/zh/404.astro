---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { t } from '../../i18n/utils';
const locale='zh-CN';
---
<BaseLayout title={t(locale,'404.title')} description={t(locale,'404.desc')} locale={locale}><section class="page-intro container"><span class="eyebrow">404</span><h1>{t(locale,'404.title')}</h1><p>{t(locale,'404.desc')}</p><a class="button button-primary" href="/zh/">{t(locale,'404.back')}</a></section></BaseLayout>
